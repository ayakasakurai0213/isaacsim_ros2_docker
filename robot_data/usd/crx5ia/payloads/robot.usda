        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/j4>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/j4_1>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link/j5>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link/j5_1>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link/J6_link>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link/J6_link/j6>,
        </crx5ia/Geometry/world/base_link/J1_link/J2_link/J3_link/J4_link/J5_link/J6_link/j6_1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "world"
        {
            over "base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "base" (
                    prepend apiSchemas = ["IsaacSiteAPI"]
                )
                {
                }

                over "base_1" (
